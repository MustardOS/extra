diff --git a/Makefile b/Makefile
index 2443f80..961aa52 100644
--- a/Makefile
+++ b/Makefile
@@ -357,10 +357,10 @@ else ifneq (,$(findstring arm64_cortex_a53_gles2,$(platform)))
