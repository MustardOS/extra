--- a/libretro/caps_loader.c	1970-01-01 10:00:00.000000000 +1000
+++ b/libretro/caps_loader.c	2026-10-05 00:09:17.592024324 +1000
@@ -0,0 +1,96 @@
+#ifdef HAVE_CAPSIMAGE
+
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include <CapsLibAll.h>
+
+extern const char *retro_system_directory;
+
+static void *caps_handle;
+static int caps_tried;
+
+static void *caps_open(const char *path)
+{
+   void *handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+   if (handle)
+      fprintf(stderr, "IPF : loaded %s\n", path);
+   return handle;
+}
+
+static void *caps_symbol(const char *name)
+{
+   if (!caps_tried)
+   {
+      char path[4096];
+
+      caps_tried = 1;
+
+      if (retro_system_directory && *retro_system_directory)
+      {
+         snprintf(path, sizeof(path), "%s/capsimg.so", retro_system_directory);
+         caps_handle = caps_open(path);
+      }
+
+      if (!caps_handle)
+         caps_handle = caps_open("capsimg.so");
+      if (!caps_handle)
+         caps_handle = caps_open("libcapsimage.so.5");
+      if (!caps_handle)
+         fprintf(stderr, "IPF : capsimg.so could not be loaded, IPF disk images are unavailable\n");
+   }
+
+   return caps_handle ? dlsym(caps_handle, name) : NULL;
+}
+
+#define CAPS_FORWARD(type, name, fail, params, args)    \
+   type name params                                     \
+   {                                                    \
+      static type (*function) params;                   \
+      if (!function)                                    \
+         *(void **)&function = caps_symbol(#name);      \
+      if (!function)                                    \
+         return fail;                                   \
+      return function args;                             \
+   }
+
+#define CAPS_FORWARD_VOID(name, params, args)           \
+   void name params                                     \
+   {                                                    \
+      static void (*function) params;                   \
+      if (!function)                                    \
+         *(void **)&function = caps_symbol(#name);      \
+      if (function)                                     \
+         function args;                                 \
+   }
+
+CAPS_FORWARD(SDWORD, CAPSInit, imgeGeneric, (void), ())
+CAPS_FORWARD(SDWORD, CAPSExit, imgeGeneric, (void), ())
+CAPS_FORWARD(SDWORD, CAPSAddImage, -1, (void), ())
+CAPS_FORWARD(SDWORD, CAPSRemImage, -1, (SDWORD id), (id))
+CAPS_FORWARD(SDWORD, CAPSLockImage, imgeGeneric, (SDWORD id, PCHAR name), (id, name))
+CAPS_FORWARD(SDWORD, CAPSLockImageMemory, imgeGeneric, (SDWORD id, PUBYTE buffer, UDWORD length, UDWORD flag), (id, buffer, length, flag))
+CAPS_FORWARD(SDWORD, CAPSUnlockImage, imgeGeneric, (SDWORD id), (id))
+CAPS_FORWARD(SDWORD, CAPSLoadImage, imgeGeneric, (SDWORD id, UDWORD flag), (id, flag))
+CAPS_FORWARD(SDWORD, CAPSGetImageInfo, imgeGeneric, (PCAPSIMAGEINFO pi, SDWORD id), (pi, id))
+CAPS_FORWARD(SDWORD, CAPSLockTrack, imgeGeneric, (PVOID ptrackinfo, SDWORD id, UDWORD cylinder, UDWORD head, UDWORD flag), (ptrackinfo, id, cylinder, head, flag))
+CAPS_FORWARD(SDWORD, CAPSUnlockTrack, imgeGeneric, (SDWORD id, UDWORD cylinder, UDWORD head), (id, cylinder, head))
+CAPS_FORWARD(SDWORD, CAPSUnlockAllTracks, imgeGeneric, (SDWORD id), (id))
+CAPS_FORWARD(PCHAR, CAPSGetPlatformName, NULL, (UDWORD pid), (pid))
+CAPS_FORWARD(SDWORD, CAPSGetVersionInfo, imgeGeneric, (PVOID pversioninfo, UDWORD flag), (pversioninfo, flag))
+CAPS_FORWARD(UDWORD, CAPSFdcGetInfo, 0, (SDWORD iid, PCAPSFDC pc, SDWORD ext), (iid, pc, ext))
+CAPS_FORWARD(SDWORD, CAPSFdcInit, imgeGeneric, (PCAPSFDC pc), (pc))
+CAPS_FORWARD_VOID(CAPSFdcReset, (PCAPSFDC pc), (pc))
+CAPS_FORWARD_VOID(CAPSFdcEmulate, (PCAPSFDC pc, UDWORD cyclecnt), (pc, cyclecnt))
+CAPS_FORWARD(UDWORD, CAPSFdcRead, 0, (PCAPSFDC pc, UDWORD address), (pc, address))
+CAPS_FORWARD_VOID(CAPSFdcWrite, (PCAPSFDC pc, UDWORD address, UDWORD data), (pc, address, data))
+CAPS_FORWARD(SDWORD, CAPSFdcInvalidateTrack, imgeGeneric, (PCAPSFDC pc, SDWORD drive), (pc, drive))
+CAPS_FORWARD(SDWORD, CAPSFormatDataToMFM, imgeGeneric, (PVOID pformattrack, UDWORD flag), (pformattrack, flag))
+CAPS_FORWARD(SDWORD, CAPSGetInfo, imgeGeneric, (PVOID pinfo, SDWORD id, UDWORD cylinder, UDWORD head, UDWORD inftype, UDWORD infid), (pinfo, id, cylinder, head, inftype, infid))
+CAPS_FORWARD(SDWORD, CAPSSetRevolution, imgeGeneric, (SDWORD id, UDWORD value), (id, value))
+CAPS_FORWARD(SDWORD, CAPSGetImageType, citError, (PCHAR name), (name))
+CAPS_FORWARD(SDWORD, CAPSGetImageTypeMemory, citError, (PUBYTE buffer, UDWORD length), (buffer, length))
+CAPS_FORWARD(SDWORD, CAPSGetDebugRequest, 0, (void), ())
+
+#endif

