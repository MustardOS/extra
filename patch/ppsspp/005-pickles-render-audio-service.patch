+
+void GLQueueRunner::PicklesMaybeService() {
+	if (!picklesServiceCallback_)
+		return;
+
+	const double now = time_now_d();
+	if (now - picklesLastServiceTime_ < PICKLES_SERVICE_INTERVAL_SECONDS)
+		return;
+
+	// Advance the deadline before entering the frontend callback. This prevents
+	// callback/backpressure time from immediately triggering another service.
+	picklesLastServiceTime_ = now;
+	picklesServiceCallback_(picklesServiceUserdata_);
+}
