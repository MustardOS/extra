diff --git a/libretro/libretro.cpp b/libretro/libretro.cpp
index 24fc766..7ff1cc4 100644
--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -687,6 +687,18 @@ static void check_variables(CoreParameter &coreParam)
          g_Config.iInternalResolution = 1;
    }
 
+   var.key = "ppsspp_pickles_output_upscaler";
+   if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+   {
+      // Pickles uses PPSSPP's upscaling-filter path to retain a 2x output
+      // surface while keeping the expensive PSP scene and effect buffers at 1x.
+      // This is intentionally a core-restart option: render resolution is
+      // selected when the GPU and libretro hardware target are created.
+      g_Config.vPostShaderNames.clear();
+      if (!strcmp(var.value, "Sharp Bilinear"))
+         g_Config.vPostShaderNames.push_back("UpscaleSharpBilinear");
+   }
+
    var.key = "ppsspp_software_rendering";
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
    {
@@ -1323,7 +1335,8 @@ void retro_get_system_info(struct retro_system_info *info)
 {
    *info = {};
    info->library_name     = "PPSSPP";
-   info->library_version  = PPSSPP_GIT_VERSION;
+   static const std::string picklesVersion = std::string(PPSSPP_GIT_VERSION) + "-pickles";
+   info->library_version  = picklesVersion.c_str();
    info->need_fullpath    = true;
    info->valid_extensions = "elf|iso|cso|prx|pbp|chd";
 }
