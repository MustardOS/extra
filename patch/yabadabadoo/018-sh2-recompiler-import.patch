+  and  w13, w0, #0xFFFFF
+  ldr  w0,  [x11, w13, uxtw]
+  ror  w0,  w0, #16
+  ret
+2:
+  cmp  w12, #0x002
+  b.ne 1f
+  ldr  x11, [x19, #176]
+  b    3b
+1:
+  b    memGetLong
+.size memGetLongFast4, .-memGetLongFast4
