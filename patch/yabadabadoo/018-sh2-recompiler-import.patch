+void CompileBlocks::ShowStatics() {
+  //LOG("Compile\t%d\t%d\t%d\n", compile_count_, exec_count_, remove_count_);
+  compile_count_ = 0;
+  exec_count_ = 0;
+  remove_count_ = 0;
+}
