+add     w1, w1, w0, lsr 31
+STR_MACH w2
+MAC_W.L12:
+  STR_MACL w1
+  b MAC_W.FINISH
+MAC_W.L10:
+  lsr     x0, x1, 32
+  stp     w0, w1, [x19, 76]
