+  tbnz w15, #0, 1f
+  ldr  x11, [x19, #168]
+  and  w13, w0, #0xFFFFF
+  eor  w13, w13, #1
+  strb w1,  [x11, w13, uxtw]
+  ret
+1:
+  b    memSetByte
+.size memSetByteFast, .-memSetByteFast
