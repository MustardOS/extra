+/*  Glue between devMiyax's SH-2 recompiler (from YabaSanshiro) and Yabadabadoo.
+
+    YabaSanshiro's memory accessors take an address and a cycle counter, and
+    the CPU being run is a global. Yabadabadoo's accessors hang off each CPU's
+    context and charge their bus waits to sh->cycles. These wrappers give the
+    recompiler the calls it expects and turn the waits into recompiler cycles.
+
+    This file is part of Yabadabadoo, GPL-2.0-or-later.
+*/
+
+#ifndef YABA_GLUE_H
+#define YABA_GLUE_H
+
+extern "C" {
+#include "../core.h"
+#include "../sh2core.h"
+#include "../memory.h"
+#include "../yabause.h"
+#include "../bios.h"
+}
+
+#include <pthread.h>
+
+/* The CPU the recompiler is running, or the master when nothing runs */
+extern "C" SH2_struct *DynGlueContext(void);
+
+/* YabaSanshiro's mutex calls, which Yabadabadoo's threads.h does not have. The recompiler
+   locks its pending interrupt table with them. */
+typedef pthread_mutex_t YabMutex;
+
+static inline YabMutex *YabThreadCreateMutex(void)
+{
+   YabMutex *m = new YabMutex;
+   pthread_mutex_init(m, NULL);
+   return m;
+}
+
+static inline void YabThreadFreeMutex(YabMutex *m)
+{
+   if (!m) return;
+   pthread_mutex_destroy(m);
+   delete m;
+}
+
+static inline void YabThreadLock(YabMutex *m) { pthread_mutex_lock(m); }
+static inline void YabThreadUnLock(YabMutex *m) { pthread_mutex_unlock(m); }
+
+static inline u8 MappedMemoryReadByte(u32 addr, u32 *cycle)
+{
+   SH2_struct *sh = DynGlueContext();
+   const u32 before = sh->cycles;
+   const u8 val = sh->MappedMemoryReadByte(sh, addr);
+   if (cycle) *cycle += sh->cycles - before;
+   sh->cycles = before;
+   return val;
+}
+
+static inline u16 MappedMemoryReadWord(u32 addr, u32 *cycle)
+{
+   SH2_struct *sh = DynGlueContext();
+   const u32 before = sh->cycles;
+   const u16 val = sh->MappedMemoryReadWord(sh, addr);
+   if (cycle) *cycle += sh->cycles - before;
+   sh->cycles = before;
+   return val;
+}
+
+static inline u32 MappedMemoryReadLong(u32 addr, u32 *cycle)
+{
+   SH2_struct *sh = DynGlueContext();
+   const u32 before = sh->cycles;
+   const u32 val = sh->MappedMemoryReadLong(sh, addr);
+   if (cycle) *cycle += sh->cycles - before;
+   sh->cycles = before;
+   return val;
+}
+
+static inline void MappedMemoryWriteByte(u32 addr, u8 val, u32 *cycle)
+{
+   SH2_struct *sh = DynGlueContext();
+   const u32 before = sh->cycles;
+   sh->MappedMemoryWriteByte(sh, addr, val);
+   if (cycle) *cycle += sh->cycles - before;
+   sh->cycles = before;
+}
+
+static inline void MappedMemoryWriteWord(u32 addr, u16 val, u32 *cycle)
+{
+   SH2_struct *sh = DynGlueContext();
+   const u32 before = sh->cycles;
+   sh->MappedMemoryWriteWord(sh, addr, val);
+   if (cycle) *cycle += sh->cycles - before;
+   sh->cycles = before;
+}
+
+static inline void MappedMemoryWriteLong(u32 addr, u32 val, u32 *cycle)
+{
+   SH2_struct *sh = DynGlueContext();
+   const u32 before = sh->cycles;
+   sh->MappedMemoryWriteLong(sh, addr, val);
+   if (cycle) *cycle += sh->cycles - before;
+   sh->cycles = before;
+}
+
+static inline u8 OnchipReadByte(u32 addr) { return OnchipReadByte(DynGlueContext(), addr); }
+static inline u16 OnchipReadWord(u32 addr) { return OnchipReadWord(DynGlueContext(), addr); }
+static inline u32 OnchipReadLong(u32 addr) { return OnchipReadLong(DynGlueContext(), addr); }
+
+/* Yabadabadoo has no extended backup RAM BIOS hooks */
+#define YABA_EXTEND_BACKUP 0
+
+#endif
