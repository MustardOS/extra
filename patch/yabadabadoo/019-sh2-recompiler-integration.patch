+/*  devMiyax's SH-2 recompiler for aarch64, as Yabadabadoo's SH2 core 3.
+    This file is part of Yabadabadoo, GPL-2.0-or-later. */
+
+#ifndef SH2_DEVMIYAX_H
+#define SH2_DEVMIYAX_H
+
+#define SH2CORE_DEVMIYAX 3
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern SH2Interface_struct SH2Dyn;
+extern int sh2_devmiyax_active;
+void SH2DynWriteNotify(u32 start, u32 length);
+void SH2DynOnFrame(SH2_struct *context);
+
+/* Work RAM written behind the CPUs' back: drop any code compiled from it */
+#define SH2_DEVMIYAX_NOTIFY(addr, size) \
+   do { if (sh2_devmiyax_active) SH2DynWriteNotify((addr), (size)); } while (0)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
