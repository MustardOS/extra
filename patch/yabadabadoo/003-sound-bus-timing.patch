--- a/yabause/src/scsp.c
+++ b/yabause/src/scsp.c
@@ -4733,10 +4733,26 @@
 
 //////////////////////////////////////////////////////////////////////////////
 
+// The SH-2 reaches sound RAM and the sound chip over the slow B-bus. Without these waits a polling
+// loop runs many times faster than on hardware, and a game's timeout can expire before the sound
+// CPU has answered (Daytona USA then turns its sound effects off). The cache code already adds
+// them when the SH-2 cache is emulated.
+int get_cache_through_timing_read_byte_word(u32 addr);
+int get_cache_through_timing_read_long(u32 addr);
+int get_cache_through_timing_write_byte_word(u32 addr);
+int get_cache_through_timing_write_long(u32 addr);
+
+static INLINE void Sh2BusWait(SH2_struct *sh, int cycles)
+{
+   if (sh && !yabsys.sh2_cache_enabled)
+      sh->cycles += cycles;
+}
+
 u8 FASTCALL
 Sh2ScspReadByte(SH2_struct *sh, u32 addr)
 {
    M68KJobWait();
+   Sh2BusWait(sh, get_cache_through_timing_read_byte_word(addr));
    return ScspReadByte(addr);
 }
 
@@ -4746,6 +4762,7 @@
 Sh2ScspWriteByte(SH2_struct *sh, u32 addr, u8 val)
 {
    M68KJobWait();
+   Sh2BusWait(sh, get_cache_through_timing_write_byte_word(addr));
    ScspWriteByte(addr, val);
 }
 
