--- a/yabause/src/libretro/libretro.c
+++ b/yabause/src/libretro/libretro.c
@@ -7,6 +7,9 @@
 #include <stddef.h>
 #include <stdio.h>
 #include <stdlib.h>
+#if defined(__linux__)
+#include <unistd.h>
+#endif
 
 #ifdef _MSC_VER
 #define snprintf _snprintf
@@ -1196,10 +1199,30 @@
    }
 
 #ifdef HAVE_THREADS
-   var.key = "yabadabadoo_worker_priority";
-   var.value = NULL;
-   YabThreadSetWorkerNice((environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value &&
-                           strcmp(var.value, "normal") == 0) ? 0 : 10);
+   {
+      int worker_nice = 0;
+      bool worker_auto = true;
+      var.key = "yabadabadoo_worker_priority";
+      var.value = NULL;
+      if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+      {
+         if (strcmp(var.value, "low") == 0)
+         {
+            worker_nice = 10;
+            worker_auto = false;
+         }
+         else if (strcmp(var.value, "normal") == 0)
+            worker_auto = false;
+      }
+#if defined(__linux__)
+      if (worker_auto)
+      {
+         long core_count = sysconf(_SC_NPROCESSORS_ONLN);
+         worker_nice = core_count > 0 && core_count <= 2 ? 10 : 0;
+      }
+#endif
+      YabThreadSetWorkerNice(worker_nice);
+   }
 #endif
 
