+static int VidsoftLayerDrawn(const int *layer_priority, const int *draw_priority_0, int layer)
+{
+   return layer_priority[layer] > 0 || draw_priority_0[layer];
+}
+
+/* A layer thread with nothing of its own to draw this frame, not yet given
+ * another layer's band, or -1 */
+static int VidsoftFreeLayerThread(const int *layer_priority, const int *draw_priority_0, int *taken)
+{
+   static const int order[] = { TITAN_NBG3, TITAN_NBG2, TITAN_RBG0 };
+   int i;
+
+   for (i = 0; i < 3; i++)
+   {
+      int layer = order[i];
+      if (!taken[layer] && !VidsoftLayerDrawn(layer_priority, draw_priority_0, layer))
+      {
+         taken[layer] = 1;
+         return layer;
+      }
+   }
+   return -1;
+}
+
+/* Like VidsoftStartLayerThread, but a scroll layer drawn on a thread is split
+ * into two bands of lines when a layer thread is free: the layer's thread
+ * draws the top half and the free one the bottom half, at the same time. In
+ * hi-res modes (Virtua Fighter: 704 pixels, zoomed) one layer alone took longer
+ * than the rest of the frame, and the main thread waited for it. */
+static void VidsoftStartLayerThreadSplit(int * layer_priority, int * draw_priority_0, int * num_threads_dispatched, int which_layer, int helper, void(*layer_func) (Vdp2* lines, Vdp2* regs, u8* ram, u8* color_ram, struct CellScrollData * cell_data))
+{
+   const int mid = vdp2height / 2;
+
+   if (helper < 0 || !VidsoftLayerDrawn(layer_priority, draw_priority_0, which_layer) ||
+       *num_threads_dispatched >= vidsoft_num_layer_threads)
+   {
+      VidsoftStartLayerThread(layer_priority, draw_priority_0, num_threads_dispatched, which_layer, layer_func);
+      return;
+   }
+
+   vidsoft_thread_context.job_func[which_layer] = NULL;
+   vidsoft_thread_context.job_band_start[which_layer] = 0;
+   vidsoft_thread_context.job_band_end[which_layer] = mid;
+   vidsoft_thread_context.job_band_second[which_layer] = 0;
+
+   vidsoft_thread_context.job_func[helper] = layer_func;
+   vidsoft_thread_context.job_band_start[helper] = mid;
+   vidsoft_thread_context.job_band_end[helper] = 0x7FFFFFFF;
+   vidsoft_thread_context.job_band_second[helper] = 1;
+
+   vidsoft_thread_context.draw_finished[which_layer] = 0;
+   vidsoft_thread_context.draw_finished[helper] = 0;
+   YabFlagSet(vidsoft_thread_context.need_draw[which_layer], 1);
+   YabFlagSet(vidsoft_thread_context.need_draw[helper], 1);
+   YabThreadWake(YAB_THREAD_VIDSOFT_LAYER_NBG3 + which_layer);
+   YabThreadWake(YAB_THREAD_VIDSOFT_LAYER_NBG3 + helper);
+   *num_threads_dispatched = *num_threads_dispatched + 1;
+}
