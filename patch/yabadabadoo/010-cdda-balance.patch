Adds the CD Music Level core option: CD audio scaled on top of the level each game sets for it
(upstream models EFSDL/EFPAN and the master volume since 97ceff1a5). Default 100%, so the game's own
mix is kept; lower it if the music drowns the sound effects.

--- a/yabause/src/libretro/libretro.c
+++ b/yabause/src/libretro/libretro.c
@@ -1149,6 +1149,12 @@
    M68KSetThreaded(!(environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value &&
                      strcmp(var.value, "disabled") == 0));
 
+   var.key = "yabadabadoo_cdda_level";
+   var.value = NULL;
+   ScspSetCDDAVolume(environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value
+                        ? (int)strtol(var.value, NULL, 10)
+                        : 100);
+
    var.key = "yabadabadoo_video_standard";
    var.value = NULL;
    video_standard = -1;
