--- a/yabause/src/cd-libretro.c
+++ b/yabause/src/cd-libretro.c
@@ -245,6 +245,7 @@ typedef struct
    u32 extraframes;
    u32 pregap;
    u32 postgap;
+   int virtual_pregap;
    u32 physframeofs;
    u32 chdframeofs;
    u32 logframeofs;
@@ -1939,6 +1940,7 @@ static int LoadCHD(const char *chd_filename, RFILE *iso_file)
 
     trk[num_tracks].pregap = pregap;
     trk[num_tracks].postgap = postgap;
+    trk[num_tracks].virtual_pregap = resulttag == CDROM_TRACK_METADATA2_TAG && pg_type[0] == 'V';
 
     trk[num_tracks].frames = frame;
     int padded = (frame + CD_TRACK_PADDING - 1) / CD_TRACK_PADDING;
@@ -2022,7 +2024,10 @@ static int LoadCHD(const char *chd_filename, RFILE *iso_file)
     }
    
     trk[num_tracks].fad_start = trk[num_tracks].fad_start + pregap;
-    trk[num_tracks].fad_end = trk[num_tracks].fad_start + (frame - 1) - pregap;
+    /* A virtual pregap is not part of FRAMES. Removing it from the playable
+     * length truncated normal Saturn CHD audio tracks by two seconds. */
+    trk[num_tracks].fad_end = trk[num_tracks].fad_start + frame - 1
+                              - (trk[num_tracks].virtual_pregap ? 0 : pregap);
     frame = trk[num_tracks].fad_end+1;
     num_tracks++;
     trk[num_tracks].fad_start = frame;
@@ -2100,12 +2105,20 @@ static int ISOCDReadSectorFADFromCHD(u32 FAD, void *buffer) {
     for (j = 0; j < disc.session[i].track_num; j++)
     {
       if (loglba < disc.session[i].track[j+1].logframeofs) {
-        if ((loglba > disc.session[i].track[j].pregap)) {
-          loglba -= disc.session[i].track[j].pregap;
-        }
-        physlba = disc.session[i].track[j].physframeofs + (loglba - disc.session[i].track[j].logframeofs);
-        chdlba = physlba - disc.session[i].track[j].physframeofs + disc.session[i].track[j].chdframeofs;
         track = &disc.session[i].track[j];
+        if (track->virtual_pregap) {
+          const u32 program_start = track->logframeofs + track->pregap;
+          if (loglba < program_start || loglba >= program_start + track->frames) {
+            memset(buffer, 0, CD_MAX_SECTOR_DATA);
+            return 1;
+          }
+          chdlba = track->chdframeofs + loglba - program_start;
+        } else {
+          if (loglba > track->pregap)
+            loglba -= track->pregap;
+          physlba = track->physframeofs + (loglba - track->logframeofs);
+          chdlba = physlba - track->physframeofs + track->chdframeofs;
+        }
         break;
       }
     }
