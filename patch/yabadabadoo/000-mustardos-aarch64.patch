--- a/yabause/src/libretro/Makefile
+++ b/yabause/src/libretro/Makefile
@@ -124,6 +124,17 @@
 		FLAGS += -DARM
 	endif
 
+	# The Play JIT behind USE_PLAY_JIT only recompiles the SH-1 of the CD block, so it must stay off here,
+	# or the Saturn's main CPUs run through it and crash as soon as they leave the BIOS. Link time
+	# optimisation lets the interpreter inline the memory accessors it calls for every instruction.
+	ifneq (,$(findstring aarch64,$(platform)))
+		HAVE_SSE = 0
+		FLAGS += -DARM -march=armv8-a+crc+crypto -mtune=cortex-a53
+		FLAGS += -flto=auto -fno-semantic-interposition -fno-plt
+		LDFLAGS += -flto=auto -O3
+		ARCH_IS_LINUX = 1
+	endif
+
 	# riscv64
 	ifneq ($(findstring riscv64,$(shell uname -a)),)
 		HAVE_SSE = 0
