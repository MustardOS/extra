+/* A wait loop may also count how long it waited, through a register that only an "add #imm"
+   changes (Daytona USA). Such a loop is still idle as long as the skipped passes are added to
+   the counter, so its register, step and cycles per pass are kept for each CPU. */
+
+#define IDLE_RECORD_MAX 64
+
+static u16 idleRecorded[IDLE_RECORD_MAX];
+static int idleRecordedCount;
+static int idleRecording;
+
+static struct {
+  int reg;
+  s32 step;
+  u32 loopCycles;
+  u32 remainder;
+} idleCounter[2] = {{-1, 0, 0, 0}, {-1, 0, 0, 0}};
+
+static void SH2idleDrop(SH2_struct *context, u32 cycles) {
+  int cpu = context == MSH2 ? 0 : 1;
+
+  if (cycles > context->cycles && idleCounter[cpu].reg >= 0 && idleCounter[cpu].loopCycles) {
+    u32 total = cycles - context->cycles + idleCounter[cpu].remainder;
+    context->regs.R[idleCounter[cpu].reg] += idleCounter[cpu].step * (s32)(total / idleCounter[cpu].loopCycles);
+    idleCounter[cpu].remainder = total % idleCounter[cpu].loopCycles;
+  }
+  context->cycles = cycles;
+}
+
+static int SH2idleCounterRegister(u32 notDet, s32 *step) {
+  // Only one plain register (R0 is also used implicitly, so never R0), changed by exactly one
+  // "add #imm" and not named by any other instruction of the loop
+  int reg, adds = 0, i;
+
+  if (idleRecordedCount > IDLE_RECORD_MAX || !notDet || (notDet & (notDet - 1)) || notDet >= 0x10000 || notDet == 1)
+    return -1;
+
+  for (reg = 1; !(notDet & (1u << reg)); reg++);
+
+  for (i = 0; i < idleRecordedCount; i++) {
+    u16 ins = idleRecorded[i];
+
+    if (INSTRUCTION_A(ins) == 7 && INSTRUCTION_B(ins) == (u32)reg) {
+      *step = (s32)(s8)INSTRUCTION_CD(ins);
+      adds++;
+    } else if (INSTRUCTION_B(ins) == (u32)reg || INSTRUCTION_C(ins) == (u32)reg)
+      return -1;
+  }
+
+  return adds == 1 && *step ? reg : -1;
+}
