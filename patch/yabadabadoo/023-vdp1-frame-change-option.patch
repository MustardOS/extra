+/* Every frame change, taken at VBlank-OUT with the VBlank End core option
+ * (vdp2.c). Returns whether the buffers changed */
+int VIDSoftVdp1FrameChange(void)
+{
+   const int change = ((Vdp1Regs->FBCR & 2) == 0) || Vdp1External.manualchange;
+   VIDSoftVdp1SwapFrameBuffer();
+   return change;
+}
