Adds an Automatic SH-2 time slice (the new default): scanline slices with the
recompiler, a tenth of a scanline with the interpreter as before.

--- a/yabause/src/libretro/libretro.c
+++ b/yabause/src/libretro/libretro.c
@@ -100,7 +100,23 @@
 static int bios_choice = 0;
 static int numthreads = 1;
 static bool sh2_use_dynarec = false;
-static int deciline_mode = 1;
+/* 1 = tenth of a scanline, 0 = scanline, -1 = automatic (see resolved_deciline_mode) */
+static int deciline_mode = -1;
+
+/* Automatic: scanline slices with the SH-2 recompiler, where a tenth of a
+ * scanline costs ~5000 entries into compiled code a frame and runs the sound
+ * CPU's queued work ten times as often (Virtua Fighter 13.0 -> 11.4 ms a
+ * frame); a tenth of a scanline with the interpreter, as before */
+static int resolved_deciline_mode(void)
+{
+   if (deciline_mode >= 0)
+      return deciline_mode;
+#ifdef SH2_DEVMIYAX
+   if (yinit.sh2coretype == SH2CORE_DEVMIYAX)
+      return 0;
+#endif
+   return 1;
+}
 /* Video standard (core option): -1 = the disc's region, else VIDEOFORMATTYPE_* */
 static int video_standard = -1;
 static int reported_pal = -1;  /* the timing the frontend was last given */
@@ -1172,9 +1188,14 @@
 
    var.key = "yabadabadoo_sh2_timeslice";
    var.value = NULL;
-   deciline_mode = 1;
+   deciline_mode = -1;
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
-      deciline_mode = strcmp(var.value, "line") != 0;
+   {
+      if (strcmp(var.value, "line") == 0)
+         deciline_mode = 0;
+      else if (strcmp(var.value, "deciline") == 0)
+         deciline_mode = 1;
+   }
 
    var.key = "yabadabadoo_numthreads";
    var.value = NULL;
@@ -1935,7 +1956,7 @@
    reported_pal = yabsys.IsPal;  /* the frontend asks for the AV info after loading */
    init_frameskip();
    OSDChangeCore(OSDCORE_DUMMY);
-   YabauseSetDecilineMode(deciline_mode);
+   YabauseSetDecilineMode(resolved_deciline_mode());
 
    log_cb(RETRO_LOG_DEBUG, "Enabling cheevos\n");
    bool cheevos_supported                  = true;
@@ -2022,7 +2043,7 @@
 #endif
    YabauseResetButton();
    YabauseInit(&yinit);
-   YabauseSetDecilineMode(deciline_mode);
+   YabauseSetDecilineMode(resolved_deciline_mode());
 }
 
 void retro_run(void)
--- a/yabause/src/libretro/libretro_core_options.h
+++ b/yabause/src/libretro/libretro_core_options.h
@@ -296,15 +296,16 @@
       "yabadabadoo_sh2_timeslice",
       "SH2 Time Slice (Restart Required)",
       NULL,
-      "How often the SH-2 CPUs are synchronized with the rest of the system. 'Tenth of a scanline' is more accurate and is required by some timing-sensitive games. 'Scanline' is faster but may prevent those games from booting. This affects both the interpreter and dynamic recompiler.",
+      "How often the SH-2 CPUs are synchronized with the rest of the system. 'Automatic' uses 'Scanline' with the dynamic recompiler and 'Tenth of a scanline' with the interpreter. 'Tenth of a scanline' is more accurate and is required by some timing-sensitive games. 'Scanline' is faster but may prevent those games from booting.",
       NULL,
       NULL,
       {
+         { "auto",     "Automatic" },
          { "deciline", "Tenth of a scanline" },
          { "line",     "Scanline" },
          { NULL, NULL },
       },
-      "deciline"
+      "auto"
    },
 #ifdef HAVE_THREADS
    {
